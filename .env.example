# Database (SQLite for local development; PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sahyog?schema=public"

# JWT Authentication
JWT_SECRET="cogig-dev-jwt-secret-2024"
JWT_REFRESH_SECRET="cogig-dev-refresh-secret-2024"
JWT_EXPIRATION="1h"
JWT_REFRESH_EXPIRATION="7d"

# Payment Gateway (for future Razorpay integration)
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""

# Maps (not needed for Leaflet/OSM, reserved for Google Maps)
MAPS_API_KEY=""

# ML Service
ML_SERVICE_URL="http://localhost:8000"

# Server
PORT=3000
NODE_ENV=development

# Frontend API Endpoint
# In local development Vite automatically proxies /api to http://127.0.0.1:3000
VITE_API_URL="/api"
# For standalone frontend deployment:
# VITE_API_URL="http://localhost:3000/api"

