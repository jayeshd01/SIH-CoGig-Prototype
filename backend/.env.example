# ================================================================
# CoGig / Sahyog Backend — Environment Template (.env.example)
# ================================================================

# Environment & Server
NODE_ENV=development
PORT=3000

# Database Connection (SQLite default; PostgreSQL supported)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sahyog?schema=public"

# JWT Authentication
JWT_SECRET="cogig-dev-jwt-secret-2024"
JWT_REFRESH_SECRET="cogig-dev-refresh-secret-2024"
JWT_EXPIRATION="1h"
JWT_REFRESH_EXPIRATION="7d"

# Frontend Origin for CORS (e.g. http://localhost:5173 or https://your-frontend.onrender.com)
FRONTEND_URL="http://localhost:5173"

# External ML Service (Optional)
ML_SERVICE_URL="http://localhost:8000"

# Payment Gateway (Optional)
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""

# Maps API Key (Optional — OpenStreetMap/Leaflet default)
MAPS_API_KEY=""
